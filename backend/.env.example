# Copiá este archivo a .env y completá los valores. El .env NUNCA se sube al repo.

# Base de desarrollo y base de test (docker compose up -d postgres). La de test se borra en cada
# corrida de pytest, así que su nombre tiene que terminar en _test.
DATABASE_URL=postgresql+psycopg://statsline:statsline@localhost:5432/statsline_dev
DATABASE_URL_TEST=postgresql+psycopg://statsline:statsline@localhost:5432/statsline_test

# Solo en producción (Aiven exige TLS): contenido del CA certificate (PEM). Ver docs/SETUP.md
# DATABASE_SSL_CA=

# Firma de la cookie de sesión. Generá una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-por-un-valor-largo-y-aleatorio

# Solo hace falta para sincronizar (DAT-001). Los tests no la usan.
API_FOOTBALL_KEY=

# Duración de la sesión (ADR-0005)
SESION_HORAS=8

# Contraseña del usuario demo (semillas/usuario_demo.py)
DEMO_CONTRASENA=

# desarrollo | test | produccion
ENTORNO=desarrollo
